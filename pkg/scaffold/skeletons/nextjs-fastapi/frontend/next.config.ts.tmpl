import type { NextConfig } from "next";

const basePath = process.env.BASE_PATH || "";

const nextConfig: NextConfig = {
  output: "standalone",
  ...(basePath ? { basePath } : {}),
  async rewrites() {
    return [
      {
        source: "/api/:path*",
        destination: `${process.env.API_BACKEND_URL || "http://{{ .Name }}-{{ .Name }}-backend:8000"}${basePath}/api/:path*`,
      },
    ];
  },
};

export default nextConfig;
